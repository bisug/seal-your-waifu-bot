# --- BOT IDENTITY ---
TOKEN=bot_token
SUB_TOKEN=secondary_token
BOT_USERNAME=SealYourWaifuBot
BOT_NAME=SEAL YOUR WAIFU

# --- TELEGRAM API CREDENTIALS ---
API_ID=1234567
API_HASH=api_hash

# --- DATABASE INFRASTRUCTURE ---
MONGO_URL=your_mongodb_connection_string
REDIS_URL=your_redis_connection_string

# --- PRIVILEGED USERS ---
OWNER_ID=123456789
SUDO_USERS=123456789,987654321

# --- CHANNEL & GROUP IDS ---
MAIN_GROUP_ID=-1001234567890
GALLERY_CHANNEL_ID=-1001234567891
LOG_GROUP_ID=-1001234567892

# --- SOCIAL & CHATS ---
SUPPORT_CHAT=your_support_chat
UPDATE_CHAT=your_update_channel

# --- MEDIA & ASSETS ---
PHOTO_URL=https://files.catbox.moe/2hsawz.jpg

# --- EXTERNAL INTEGRATIONS ---
IMGBB_API_KEY=imgbb_key

# --- WEBAPP CONFIG ---
WEB_APP_URL=https://your-app-name.herokuapp.com
MINI_APP_SHORT_NAME=app
API_VERSION_PREFIX=v1_7b82

# --- LOGGING ---
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_DIR=logs
LOG_FILE=seal-bot.log
LOG_FILE_ENABLED=false
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_UTC=true

# --- RESOURCE MANAGEMENT ---
RESOURCE_MONITOR_ENABLED=true
RESOURCE_CHECK_INTERVAL_SECONDS=60
RESOURCE_MEMORY_SOFT_LIMIT_MB=0
RESOURCE_MEMORY_HARD_LIMIT_MB=0
RESOURCE_MIN_AVAILABLE_MB=0
RESOURCE_GC_COOLDOWN_SECONDS=120
RESOURCE_TASK_SOFT_LIMIT=500
RESOURCE_SHUTDOWN_TIMEOUT_SECONDS=10
RESOURCE_REDIS_PURGE_BATCH_SIZE=100
REDIS_MEMORY_LIMIT_MB=0

# --- USERBOT CONFIG ---
STRING_SESSION=session_string
