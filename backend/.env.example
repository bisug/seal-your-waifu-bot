# Seal-Bot-V2 environment template.
#
# Copy this file to backend/.env and fill in real values:
#   cp backend/.env.example backend/.env
#
# NEVER commit real credentials. backend/.env is git-ignored. In production,
# set these in the host's secret manager / env-var UI instead.
# Every value below is a placeholder — replace or leave empty.

# --- BOT IDENTITY ---
# Main bot token from BotFather.
TOKEN=
# Secondary GameBot token from BotFather.
SUB_TOKEN=
# Fetched automatically at startup; override only if needed.
#BOT_USERNAME=SealYourWaifuBot
#BOT_NAME=SEAL YOUR WAIFU

# --- TELEGRAM API CREDENTIALS (my.telegram.org) ---
API_ID=0
API_HASH=

# --- DATABASE INFRASTRUCTURE ---
# MongoDB connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net/db
MONGO_URL=
# Redis connection string, e.g. redis://localhost:6379/0
REDIS_URL=

# --- PRIVILEGED USERS ---
# Primary owner Telegram user ID.
OWNER_ID=0
# Comma-separated startup moderator user IDs.
SUDO_USERS=

# --- CHANNEL & GROUP IDS ---
MAIN_GROUP_ID=
GALLERY_CHANNEL_ID=
LOG_GROUP_ID=

# --- SOCIAL & CHATS ---
SUPPORT_CHAT=
UPDATE_CHAT=

# --- MEDIA & ASSETS ---
# Comma-separated fallback/start image URLs.
PHOTO_URL=

# --- EXTERNAL INTEGRATIONS ---
# Optional image host key for upload fallback paths.
IMGBB_API_KEY=

# --- WEBAPP CONFIG ---
# Public HTTPS origin of the Mini App / backend.
WEB_APP_URL=
# The 'Short Name' you set in BotFather for the Mini App.
MINI_APP_SHORT_NAME=app
# API path prefix.
API_VERSION_PREFIX=v1_7b82

# --- LOGGING ---
LOG_LEVEL=INFO
# text or json
LOG_FORMAT=text
LOG_DIR=logs
LOG_FILE=seal-bot.log
LOG_FILE_ENABLED=false
