import asyncio
import random
from telegram import Update, InlineKeyboardMarkup, InlineKeyboardButton
from telegram.ext import CommandHandler, CallbackQueryHandler, MessageHandler, filters, CallbackContext
from pymongo import MongoClient

from Grabber import user_collection, application

# Active battle requests
active_battles = {}

async def get_balance(user_id: int):
    """Fetch the user's balance from the database."""
    user_data = await user_collection.find_one({"id": user_id}, projection={"balance": 1})
    return user_data.get("balance", 0) if user_data else 0

async def update_balance(user_id: int, amount: int):
    """Update the user's balance by adding/subtracting the amount."""
    if amount == 0:
        return
    await user_collection.update_one({"id": user_id}, {"$inc": {"balance": amount}}, upsert=True)

async def battle(update: Update, context: CallbackContext):
    """Initiate a battle request."""
    if not update.message.reply_to_message:
        await update.message.reply_text("⚠️ You must reply to a user's message to challenge them to battle!")
        return

    attacker_id = update.effective_user.id
    defender_id = update.message.reply_to_message.from_user.id

    if attacker_id == defender_id:
        await update.message.reply_text("⚠️ You cannot battle yourself!")
        return

    try:
        bet_amount = int(context.args[0])
        if bet_amount <= 0:
            raise ValueError
    except (IndexError, ValueError):
        await update.message.reply_text("⚠️ Invalid bet amount. Usage: `/battle <bet_amount>`", parse_mode="Markdown")
        return

    attacker_balance = await get_balance(attacker_id)
    defender_balance = await get_balance(defender_id)

    if attacker_balance < bet_amount:
        await update.message.reply_text(f"❌ You don't have enough balance! Your balance: 💰 {attacker_balance}")
        return

    if defender_balance < bet_amount:
        await update.message.reply_text(f"❌ {update.message.reply_to_message.from_user.first_name} doesn't have enough balance!")
        return

    battle_id = f"{attacker_id}_{defender_id}"
    active_battles[battle_id] = {"attacker": attacker_id, "defender": defender_id, "bet": bet_amount}

    keyboard = InlineKeyboardMarkup([
        [InlineKeyboardButton("⚔ Accept Battle", callback_data=f"accept_{battle_id}")]
    ])
    await update.message.reply_to_message.reply_text(
        f"⚔ {update.effective_user.first_name} has challenged you to a battle! 💰 Bet: {bet_amount} coins\n\n"
        "Click below to accept.",
        reply_markup=keyboard
    )

async def handle_battle_response(update: Update, context: CallbackContext):
    """Handle the accept button click for battle requests."""
    query = update.callback_query
    query_data = query.data

    if not query_data.startswith("accept_"):
        await query.answer("❌ Invalid request.", show_alert=True)
        return

    _, attacker_id, defender_id = query_data.split("_")
    attacker_id, defender_id = int(attacker_id), int(defender_id)

    battle_id = f"{attacker_id}_{defender_id}"
    battle_data = active_battles.get(battle_id)

    if not battle_data:
        await query.answer("❌ This battle request is no longer valid.", show_alert=True)
        return

    if query.from_user.id != defender_id:
        await query.answer("❌ You are not the challenged user!", show_alert=True)
        return

    bet_amount = battle_data["bet"]
    attacker_balance = await get_balance(attacker_id)
    defender_balance = await get_balance(defender_id)

    if attacker_balance < bet_amount or defender_balance < bet_amount:
        await query.message.edit_text("❌ One of the players no longer has enough balance! Battle cancelled.")
        del active_battles[battle_id]
        return

    await update_balance(attacker_id, -bet_amount)
    await update_balance(defender_id, -bet_amount)

    attacker_chat = await context.bot.get_chat(attacker_id)
    defender_chat = await context.bot.get_chat(defender_id)

    await query.message.edit_text(
        f"⚔️ **Battle Started!**\n\n"
        f"{attacker_chat.first_name} ⚡ vs {defender_chat.first_name}\n\n"
        "🔥 **Fighting...** 🔥"
    )

    await asyncio.sleep(2)

    battle_messages = [
        f"⚡ {attacker_chat.first_name} strikes first with a powerful punch!",
        f"💥 {defender_chat.first_name} dodges and counters with a kick!",
        f"🌀 {attacker_chat.first_name} uses a special move!",
        f"🔥 {defender_chat.first_name} lands a critical hit!",
        f"⚔ Both fighters are exhausted but still going strong!"
    ]

    for msg in battle_messages:
        await query.message.reply_text(msg)
        await asyncio.sleep(2)

    winner_id = random.choice([attacker_id, defender_id])
    loser_id = attacker_id if winner_id == defender_id else defender_id

    winnings = bet_amount * 3
    await update_balance(winner_id, winnings)

    winner_chat = await context.bot.get_chat(winner_id)

    await query.message.reply_text(
        f"🏆 **Battle Over!**\n\n"
        f"🥇 **Winner:** {winner_chat.first_name} (+💰 {winnings} coins)!\n\n"
        "⚔ Thanks for fighting!"
    )

    del active_battles[battle_id]

application.add_handler(CommandHandler("battle", battle))
application.add_handler(CallbackQueryHandler(handle_battle_response, pattern="^accept_"))
